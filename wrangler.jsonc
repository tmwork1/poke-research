{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-07-03",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "poke-research",
	"main": "./src/worker.ts",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	// 週次DBレビュー（POST /api/maintenance/weekly-review）の重複検出はO(件数^2)のLevenshtein距離
	// 比較を伴い、fetchハンドラの既定CPU制限（プランによっては数十ms）を超えて
	// "Worker exceeded resource limits"（error 1102）になることが2026-08-30に判明した
	// （旧cronのscheduledハンドラはCPU上限30秒のため問題化していなかった）。
	// GitHub Actions移設でこの処理がHTTP経由（fetchハンドラ）になったため、CPU時間上限を
	// scheduledハンドラと同じ30秒まで明示的に引き上げる。
	"limits": {
		"cpu_ms": 30000
	},
	"triggers": {
		// 2026-08-30 に定期実行の起点を GitHub Actions（.github/workflows/cron-*.yml）へ移設した。
		// Cloudflare Cron Trigger は無効化している。src/worker.ts の scheduled ハンドラは、移行直後のロールバック用として残す。
		// 問題時はこの配列に以前の値を戻して復帰できる。安定後に worker 側の cron 関連コードを削除する予定。
		// 設計判断の詳細は docs/scheduled-jobs.md を参照。
		"crons": []
	}
}
